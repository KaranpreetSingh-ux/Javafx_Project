<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="login-screen" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Starter_App.Starter_Ap.Login">

   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>

   <children>
      <VBox alignment="CENTER" layoutX="21.0" layoutY="0.0" prefHeight="400.0" prefWidth="184.0" spacing="18.0" styleClass="login-brand-panel">
         <children>
            <Circle radius="34.0" styleClass="logo-mark" />
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Order Admin" textAlignment="CENTER" wrappingWidth="140.0">
               <font>
                  <Font size="22.0" />
               </font>
            </Text>
            <Label alignment="CENTER" prefWidth="140.0" text="Manage of the orders component : ADMIN USERNAME: Admin PASSWORD: alpha User: USERNAME: user PASSWORD: Beta " textAlignment="CENTER" textFill="#B7C4D3" wrapText="true" />
         </children>
      </VBox>

      <VBox layoutX="252.0" layoutY="48.0" prefHeight="304.0" prefWidth="288.0" spacing="13.0" styleClass="login-card">
         <children>
            <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Login">
               <font>
                  <Font size="28.0" />
               </font>
            </Text>
            <Label text="Welcome back, Admin" textFill="#B7C4D3" />

            <Label text="Username" textFill="WHITE" />
            <TextField fx:id="usernameField" promptText="Enter username" styleClass="login-input" />

            <Label text="Password" textFill="WHITE" />
            <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="login-input" />

            <AnchorPane prefHeight="30.0" prefWidth="248.0">
               <children>
                  <CheckBox fx:id="rememberCheckBox" layoutX="0.0" layoutY="5.0" mnemonicParsing="false" text="Worked" textFill="#B7C4D3" />
                  <Hyperlink fx:id="forgotPasswordLink" layoutX="151.0" layoutY="0.0" text="Forgot password?" />
               </children>
            </AnchorPane>

            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#LoginButton" prefHeight="36.0" prefWidth="248.0" styleClass="login-button" text="LOGIN" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>

      <Text fill="#B7C4D3" layoutX="456.0" layoutY="35.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Secure Login" />
   </children>
</AnchorPane>
