<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="DBScreen" stylesheets="@table.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Starter_App.Starter_Ap.Return_Controllor">

   
   <children>
      <Text fill="WHITE" layoutX="52.0" layoutY="41.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Order Data">
         <font>
            <Font size="25.0" />
         </font>
      </Text>
      <TextField fx:id="searchField" layoutX="73.0" layoutY="59.0" prefHeight="26.0" prefWidth="504.0" promptText="   🔍  Search  Orders ID , Customers ,  Products" styleClass="search-field" />
      <TableView fx:id="TableAll" layoutX="-6.0" layoutY="158.0" prefHeight="238.0" prefWidth="583.0" styleClass="orders-table">
        <columns>
          <TableColumn fx:id="CB" prefWidth="78.0" text="Select" />
        <TableColumn fx:id="OrderId" prefWidth="70.0" text="Order ID" />
        <TableColumn fx:id="Customer" prefWidth="92.0" text="Customer" />
        <TableColumn fx:id="Date" prefWidth="72.0" text="Date" />
        <TableColumn fx:id="ProductName" prefWidth="86.0" text="Product" />
        <TableColumn fx:id="Status" prefWidth="82.0" text="Status" />
        <TableColumn fx:id="Total" prefWidth="76.0" text="Total" />
        </columns>
      </TableView>
      
      <Button fx:id="ALL" layoutX="46.0" layoutY="109.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #121B26;" text="ALL" textFill="#fffefe" />
      <Button fx:id="ProcessingData" layoutX="100.0" layoutY="111.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #121B26;" text="Processing" textFill="#fffefe" />
      <Button fx:id="DeliveryData" layoutX="179.0" layoutY="111.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #121B26;" text="Delivery" textFill="#fffefe" />
      <Button fx:id="ShippedData" layoutX="243.0" layoutY="110.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #121B26;" text="Shipping" textFill="#fffefe" />
      <Button fx:id="ReturnData" layoutX="310.0" layoutY="109.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #375476;" text="Return" textFill="#fffefe" />
      <Button fx:id="Back" layoutX="6.0" layoutY="12.0" mnemonicParsing="false" onAction="#Table" style="-fx-background-color: #0B131E;" text="&lt;" textFill="WHITE">
         <font>
            <Font size="19.0" />
         </font></Button>
   </children>
</AnchorPane>
